# Copie para .env e preencha. NUNCA commite o .env.
DOMAIN=localhost            # em produção: prophet.seudominio.com (Caddy emite o HTTPS sozinho)
POSTGRES_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-com-openssl-rand-hex-32
ALLOW_REGISTRATION=true     # depois de criar sua conta, mude para false
BRAPI_TOKEN=                # token gratuito em https://brapi.dev
# Opcional: ranges liberados no seu plano da brapi (o app também aprende isso do erro 400). Ex.: 1d,5d,1mo,3mo
BRAPI_RANGES=
# Opcional: feriados/pregões cancelados extras (AAAA-MM-DD, separados por vírgula). A lista base da B3 está em web/src/lib/market.ts
MARKET_HOLIDAYS=
TELEGRAM_BOT_TOKEN=         # criado no @BotFather

# --- Operar na Binance (opcional) ---
# Chave que criptografa as API keys guardadas no banco. Gere com: openssl rand -hex 32  (se perder, é preciso recadastrar as chaves)
CREDENTIALS_KEY=
# Ordens em PRODUÇÃO (dinheiro real) ficam bloqueadas, a menos que isto seja true. Homologação (testnet) não depende disso.
BINANCE_ALLOW_PRODUCTION=false
# Valor máximo por ordem em produção, em USDT (só pares cotados em stablecoin)
TRADE_MAX_NOTIONAL_USDT=100
# Anos de histórico diário da B3 a importar dos arquivos oficiais (0 desliga)
HISTORY_YEARS=5
