# Copie para .env e preencha. NUNCA commite o .env.
DOMAIN=localhost            # em produção: prophet.seudominio.com (Caddy emite o HTTPS sozinho)
POSTGRES_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-com-openssl-rand-hex-32
ALLOW_REGISTRATION=true     # depois de criar sua conta, mude para false
BRAPI_TOKEN=                # token gratuito em https://brapi.dev
TELEGRAM_BOT_TOKEN=         # criado no @BotFather
